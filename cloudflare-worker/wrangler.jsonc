{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a-to-z-counter",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "../web",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "a-to-z-counter",
      "database_id": "877c5318-74d8-4901-8047-d44d08262ec5",
      "migrations_dir": "migrations"
    }
  ]
}
